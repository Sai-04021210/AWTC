    {
        "id": "d9b7e8d2.c5b8c8",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Set Low Threshold",
        "func": "// Store low threshold in flow context\nflow.set('low_threshold', msg.payload);\n\n// Ensure high threshold is higher than low threshold\nconst highThreshold = flow.get('high_threshold') || 80;\nif (msg.payload >= highThreshold) {\n    // Adjust high threshold to be at least 10% higher than low threshold\n    const newHighThreshold = Math.min(100, msg.payload + 10);\n    flow.set('high_threshold', newHighThreshold);\n}\n\nreturn {\n    topic: \"threshold_update\",\n    payload: {\n        low_threshold: msg.payload,\n        high_threshold: flow.get('high_threshold')\n    }\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "// Initialize with default values\nflow.set('low_threshold', 20);\nif (!flow.get('high_threshold')) {\n    flow.set('high_threshold', 80);\n}",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 520,
        "wires": [
            [
                "1b8c7d9e.4f9b42"
            ]
        ]
    },
    {
        "id": "c9b7e8d2.c5b8c8",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Set High Threshold",
        "func": "// Store high threshold in flow context\nflow.set('high_threshold', msg.payload);\n\n// Ensure low threshold is lower than high threshold\nconst lowThreshold = flow.get('low_threshold') || 20;\nif (msg.payload <= lowThreshold) {\n    // Adjust low threshold to be at least 10% lower than high threshold\n    const newLowThreshold = Math.max(0, msg.payload - 10);\n    flow.set('low_threshold', newLowThreshold);\n}\n\nreturn {\n    topic: \"threshold_update\",\n    payload: {\n        low_threshold: flow.get('low_threshold'),\n        high_threshold: msg.payload\n    }\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "// Initialize with default values\nflow.set('high_threshold', 80);\nif (!flow.get('low_threshold')) {\n    flow.set('low_threshold', 20);\n}",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 580,
