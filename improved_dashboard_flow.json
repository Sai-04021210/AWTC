    {
        "id": "f9b7e8d2.c5b8c8",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Toggle Pump",
        "func": "// Get current pump status\nconst currentStatus = flow.get('pumpStatus') || false;\nconst newStatus = !currentStatus;\n\n// Update flow variable\nflow.set('pumpStatus', newStatus);\nflow.set('manualMode', true);\n\nreturn {\n    payload: {\n        status: newStatus ? 'ON' : 'OFF',\n        value: newStatus ? 1 : 0,\n        timestamp: new Date().toISOString(),\n        manual: true\n    }\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 340,
