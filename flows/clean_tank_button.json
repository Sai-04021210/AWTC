    {
        "id": "cleaning_mode_function",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Extract Cleaning Mode",
        "func": "// Store cleaning mode in flow context\nif (msg.payload.cleaning_mode !== undefined) {\n    flow.set('cleaningMode', msg.payload.cleaning_mode);\n}\n\n// Format message for display\nreturn {\n    payload: {\n        cleaning: msg.payload.cleaning_mode\n    }\n};",
