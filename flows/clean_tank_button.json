    {
        "id": "clean_tank_function",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Toggle Cleaning Mode",
        "func": "// Get current cleaning state from flow context or default to false\nconst currentCleaningMode = flow.get('cleaningMode') || false;\n\n// Toggle the cleaning mode\nconst newCleaningMode = !currentCleaningMode;\n\n// Store the new state in flow context\nflow.set('cleaningMode', newCleaningMode);\n\n// Create message payload\nreturn {\n    payload: {\n        cleaning: newCleaningMode,\n        timestamp: new Date().toISOString()\n    }\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 840,
        "wires": [
            [
                "clean_tank_mqtt",
                "clean_tank_status"
            ]
        ]
    },
