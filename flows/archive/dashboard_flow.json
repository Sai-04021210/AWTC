    {
        "id": "f9b7e8d2.c5b8c8",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Toggle Pump",
        "func": "// This is just a placeholder for manual control\n// In a real implementation, this would interact with the pump controller\nconst currentStatus = flow.get('pumpStatus') || false;\nconst newStatus = !currentStatus;\n\nflow.set('pumpStatus', newStatus);\n\nreturn {\n    payload: {\n        status: newStatus ? 'ON' : 'OFF',\n        value: newStatus ? 1 : 0,\n        timestamp: new Date().toISOString(),\n        manual: true\n    }\n};",
