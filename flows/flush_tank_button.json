    {
        "id": "flush_mode_function",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Extract Flush Mode",
        "func": "// Store flush mode in flow context\nif (msg.payload.flush_mode !== undefined) {\n    flow.set('flushMode', msg.payload.flush_mode);\n}\n\n// Format message for display\nreturn {\n    payload: {\n        flush: msg.payload.flush_mode\n    }\n};",
