    {
        "id": "flush_tank_function",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Toggle Flush Mode",
        "func": "// Get current flush state from flow context or default to false\nconst currentFlushMode = flow.get('flushMode') || false;\n\n// Toggle the flush mode\nconst newFlushMode = !currentFlushMode;\n\n// Store the new state in flow context\nflow.set('flushMode', newFlushMode);\n\n// If turning on flush mode, turn off cleaning mode to avoid conflicts\nif (newFlushMode) {\n    flow.set('cleaningMode', false);\n}\n\n// Create message payload\nreturn {\n    payload: {\n        flush: newFlushMode,\n        timestamp: new Date().toISOString()\n    }\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 960,
        "wires": [
            [
                "flush_tank_mqtt",
                "flush_tank_status"
            ]
        ]
    },
